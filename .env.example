# 环境变量模板。
# 本地开发：复制为 .env.local，然后填写本机需要的密钥、Cookie、端口和路径。
# 线上部署：不要上传 .env.local，请在部署平台的环境变量面板中写入同名变量。
# 需要重点填写的敏感项：AI_RELAY_API_KEY / OPENAI_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY / FENBI_COOKIE。

# AI 服务商选择。本地和线上都建议显式设置，默认使用 relay。
AI_DEFAULT_PROVIDER=relay

# Relay 服务商配置。本地和线上如使用默认 AI 分析服务，需要填写 AI_RELAY_API_KEY。
AI_RELAY_NAME=AI relay
AI_RELAY_BASE_URL=https://relay.nf.video/v1
AI_RELAY_MODEL=gpt-5.5
AI_RELAY_WIRE_API=responses
AI_RELAY_REASONING_EFFORT=high
AI_RELAY_DISABLE_RESPONSE_STORAGE=true
AI_RELAY_API_KEY=

# OpenAI 兼容服务商配置。只在启用对应 provider 时填写对应 API Key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 粉笔 Cookie。本地可在这里填写，也可以启动后通过 /admin.html 写入。
# 线上建议只通过部署平台环境变量填写 FENBI_COOKIE。
FENBI_COOKIE=

# 数据和前端文件路径。
# 本地：一般保持 data / frontend 默认值即可。
# 线上：如部署平台不支持持久化文件系统，需要改造为外部存储；不要依赖 FENBI_DATA_DIR 保存长期状态。
FENBI_FIXTURE_DATA_DIR=data
FENBI_DATA_DIR=data
FENBI_FRONTEND_DIR=frontend
FENBI_PAGES_DIR=frontend/pages
FENBI_STATIC_DIR=frontend/assets

# 请求来源白名单。
# 本地：如果修改启动端口，需要同步修改这里。
# 线上：填写正式站点域名，例如 https://example.com；多个来源用英文逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 运行参数。本地通常使用默认值；线上可按接口频率、上游稳定性和成本策略调整。
REPORT_CACHE_TTL_SECONDS=14400
FENBI_TIMEOUT_SECONDS=20
SILENT_REFRESH_JITTER_MIN_SECONDS=60
SILENT_REFRESH_JITTER_MAX_SECONDS=600
UPSTREAM_REQUEST_DELAY_MIN_SECONDS=1.2
UPSTREAM_REQUEST_DELAY_MAX_SECONDS=3.5
MANUAL_REFRESH_LIMIT_PER_HOUR=3
